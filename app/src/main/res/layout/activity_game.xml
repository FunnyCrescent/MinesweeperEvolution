<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top status bar: mines, time, shift, pause (all inside HUD frame) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_bar"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_margin="8dp"
        android:weightSum="4"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvMines"
                style="@style/TopBarValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/danger" />

            <TextView
                style="@style/TopBarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mines_left" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvTime"
                style="@style/TopBarValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/accent" />

            <TextView
                style="@style/TopBarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llShift"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvShift"
                style="@style/TopBarValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/warning" />

            <TextView
                style="@style/TopBarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shift_in" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/icon_pause"
                android:background="@android:color/transparent"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/menu" />

            <TextView
                style="@style/TopBarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvModeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/vt323"
            android:text="—" />
    </LinearLayout>

    <!-- GameView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.zminesweeper.game.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Bottom panel: Zoom out | Pickaxe/Flag toggle | Zoom in -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/bg_panel"
        android:padding="8dp">

        <TextView
            android:id="@+id/btnZoomOut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="@font/press_start_2p"
            android:text="−"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="32dp" />

        <ImageView
            android:id="@+id/btnFlagMode"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/item_pickaxe"
            android:background="@drawable/bg_button_secondary"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/btnZoomIn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="@font/press_start_2p"
            android:text="+"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="32dp" />
    </LinearLayout>

</LinearLayout>
