<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Индикатор хода -->
    <TextView
        android:id="@+id/tvTurnIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_bar"
        android:padding="12dp"
        android:layout_margin="8dp"
        android:gravity="center"
        android:fontFamily="@font/press_start_2p"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:maxLines="1"
        android:text="@string/mp_your_turn" />

    <!-- Top status bar (как в обычной игре) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_bar"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="8dp"
        android:weightSum="5">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvMines"
                style="@style/TopBarValue"
                android:fontFamily="@font/press_start_2p"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/danger" />

            <TextView
                style="@style/TopBarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mines_left" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvTime"
                style="@style/TopBarValue"
                android:fontFamily="@font/press_start_2p"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/accent" />

            <TextView
                style="@style/TopBarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llShift"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvShift"
                style="@style/TopBarValue"
                android:fontFamily="@font/press_start_2p"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/warning" />

            <TextView
                style="@style/TopBarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shift_in" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/btnFlagMode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ui_button_normal"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/item_flag"
                android:contentDescription="@string/flag_mode"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                style="@style/TopBarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flag_mode" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ui_button_normal"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_pause"
                android:contentDescription="@string/menu"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                style="@style/TopBarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvModeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vt323"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:maxLines="1"
            android:text="—" />
    </LinearLayout>

    <!-- Game grid container -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <com.zminesweeper.game.GameView
                    android:id="@+id/mpGameView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>
        </ScrollView>
    </HorizontalScrollView>

</LinearLayout>
