<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mp_relay_host_title"
            android:fontFamily="@font/press_start_2p"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- ============ Секция: Сервер ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_server"
            android:fontFamily="@font/press_start_2p"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/relay_url_hint"
            android:fontFamily="@font/vt323"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etRelayHostUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_panel"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:textSize="14sp"
            android:inputType="textUri"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRelayHostCreate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="@font/pixelify_sans"
            android:text="@string/create_room"
            android:textColor="@color/bg_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvHostRoomId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_panel"
            android:padding="16dp"
            android:textColor="@color/accent"
            android:fontFamily="@font/vt323"
            android:textSize="16sp"
            android:gravity="center"
            android:textIsSelectable="true"
            android:layout_marginBottom="12dp"
            android:text="@string/room_code_placeholder" />

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_dim"
            android:layout_marginBottom="16dp" />

        <!-- ============ Секция: Настройки игры ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_game_settings"
            android:fontFamily="@font/press_start_2p"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnHostNick"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="@font/pixelify_sans"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp" />

        <Button
            android:id="@+id/btnPickMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="@font/pixelify_sans"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp" />

        <Button
            android:id="@+id/btnPickDiff"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="@font/pixelify_sans"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp" />

        <Button
            android:id="@+id/btnPickShift"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="@font/pixelify_sans"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp" />

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_dim"
            android:layout_marginBottom="16dp" />

        <!-- ============ Секция: Игроки ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_players"
            android:fontFamily="@font/press_start_2p"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/playersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_dim"
            android:layout_marginBottom="16dp" />

        <!-- ============ Секция: Лог ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_log"
            android:fontFamily="@font/press_start_2p"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLobbyLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_panel"
            android:padding="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/vt323"
            android:minLines="3"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnStartMp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="@font/pixelify_sans"
            android:text="@string/mp_start_game"
            android:textColor="@color/bg_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCloseLobby"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="@font/pixelify_sans"
            android:text="@string/close_lobby"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
