<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vibration"
        android:fontFamily="@font/pixelify_sans"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swVibration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pixelify_sans"
        android:textColor="@color/text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/text_dim" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sound"
        android:fontFamily="@font/pixelify_sans"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swSound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pixelify_sans"
        android:textColor="@color/text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/text_dim" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/long_press_flag"
        android:fontFamily="@font/pixelify_sans"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swLongPress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pixelify_sans"
        android:textColor="@color/text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/text_dim" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shift_interval"
        android:fontFamily="@font/pixelify_sans"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvShiftVal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shift_default_value"
        android:fontFamily="@font/vt323"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/sliderShift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="27"
        android:progress="7" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/text_dim" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/language"
        android:fontFamily="@font/pixelify_sans"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spLanguage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pixelify_sans" />

</LinearLayout>
