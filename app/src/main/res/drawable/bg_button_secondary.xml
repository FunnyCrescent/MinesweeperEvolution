<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Включённое состояние (flagMode ON) — акцентный фон -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/accent_2"/>
        </shape>
    </item>
    <!-- Нажатое состояние — тонкая рамка акцента -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_panel_alt"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2dp" android:color="@color/accent"/>
        </shape>
    </item>
    <!-- Обычное состояние -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_panel_alt"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/text_dim"/>
        </shape>
    </item>
</selector>
